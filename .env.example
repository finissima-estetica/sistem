# Configuração do Banco de Dados em Nuvem - Render
# Siga as instruções em INSTRUCOES_RENDER.md

# DATABASE_URL do Render PostgreSQL
# Copie a Internal Database URL do seu serviço PostgreSQL no Render
# Formato: postgresql://[user]:[password]@[host].a.render.com:5432/[database]
DATABASE_URL=postgresql://clinica_user:[SUA_SENHA]@[HOST].a.render.com:5432/clinica_estetica

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=production