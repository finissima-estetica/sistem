# Configuração do Banco de Dados em Nuvem
# Escolha uma das opções abaixo e configure a URL correspondente

# Opção 1: Supabase (PostgreSQL gratuito em nuvem)
# 1. Crie uma conta em https://supabase.com
# 2. Crie um novo projeto
# 3. Vá em Settings > Database
# 4. Copie a Connection String (URI)
# 5. Cole abaixo substituindo <sua-url>
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres

# Opção 2: Replit PostgreSQL (se ainda estiver disponível)
# DATABASE_URL=postgresql://replit:[sua-senha]@host.replit.com:5432/replitdb

# Opção 3: Railway PostgreSQL
# 1. Crie uma conta em https://railway.app
# 2. Crie um novo projeto PostgreSQL
# 3. Copie a DATABASE_URL
# DATABASE_URL=postgresql://postgres:[sua-senha]@[host].railway.app:5432/railway

# Opção 4: Render PostgreSQL
# 1. Crie uma conta em https://render.com
# 2. Crie um novo PostgreSQL Database
# 3. Copie a Internal Database URL
# DATABASE_URL=postgresql://postgres:[sua-senha]@[host].a.render.com:5432/renderdb

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=production